#!/usr/bin/env bash
# This sets bash to:
# - exit immediately if a command exits with a non-zero status (e)
# - exit if any command in a pipeline fails (o)
# - treat unset variables as an error (u)
# - fail on pipe errors (pipefail)
set -euo pipefail
IFS=$'\n\t'

# The -v (verbose) flag makes bash print each command before executing it
# The -x (xtrace) flag makes bash print each command with variable substitutions
set -vx

bundle exec yard server --plugin apptweak-template --verbose --reload